{
	"name": "primeplaced-advanced-password-protection",
	"version": "1.0.3",
	"description": "Simple password protection for your site. Designed for campaigns, client drafts, and private content. Gutenberg ready.",
	"author": "Dobrzepostawieni <contact@dobrzepostawieni.pl>",
	"license": "GPL-3.0-or-later",
	"keywords": [
		"wordpress",
		"password-protection",
		"security",
		"private-site"
	],
	"homepage": "https://dobrzepostawieni.pl/advanced-password-protection",
	"repository": {
		"type": "git",
		"url": "https://github.com/Dobrzepostawieni/primeplaced-advanced-password-protection.git"
	},
	"bugs": {
		"url": "https://github.com/Dobrzepostawieni/primeplaced-advanced-password-protection/issues"
	},
	"engines": {
		"node": ">=18.12.0",
		"npm": ">=8.0.0"
	},
	"dependencies": {
		"@freemius/checkout": "^1.5.0",
		"chart.js": "^4.5.1",
		"clsx": "^2.1.1",
		"react-chartjs-2": "^5.3.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.12.1",
		"@playwright/test": "1.61.1",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/babel__core": "^7.20.0",
		"@types/jquery": "^3.5.16",
		"@types/jqueryui": "^1.12.16",
		"@types/node": "^25.6.0",
		"@types/react": "^18.2.0",
		"@types/react-dom": "^18.2.0",
		"@types/wordpress__block-editor": "^11.5.1",
		"@types/wordpress__blocks": "^12.5.0",
		"@types/wordpress__edit-post": "^8.4.2",
		"@types/wordpress__element": "^2.4.1",
		"@types/wordpress__i18n": "^3.4.0",
		"@wordpress/base-styles": "^6.13.0",
		"@wordpress/block-editor": "^15.10.0",
		"@wordpress/components": "37.0.0",
		"@wordpress/core-data": "^7.37.0",
		"@wordpress/edit-post": "^8.38.0",
		"@wordpress/element": "^6.37.0",
		"@wordpress/eslint-plugin": "^13.10.4",
		"@wordpress/i18n": "^6.10.0",
		"@wordpress/icons": "^11.5.0",
		"@wordpress/plugins": "^7.38.0",
		"@wordpress/prettier-config": "^4.38.0",
		"@wordpress/scripts": "^31.8.0",
		"@wordpress/stylelint-config": "^23.35.0",
		"ajv": "^8.20.0",
		"copy-webpack-plugin": "^14.0.0",
		"css-declaration-sorter": "^7.4.0",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-jsdoc": "^48.0.0",
		"eslint-plugin-prettier": "3.4.1",
		"identity-obj-proxy": "^3.0.0",
		"jest-junit": "^17.0.0",
		"postcss-combine-duplicated-selectors": "^10.0.3",
		"postcss-sort-media-queries": "^6.5.0",
		"prettier": "^3.0.0",
		"stylelint": "^16.0.0",
		"typescript": "^5.9.3"
	},
	"scripts": {
		"start": "wp-scripts start",
		"build": "wp-scripts build",
		"typecheck": "tsc --project tsconfig.json --noEmit",
		"lint:js": "wp-scripts lint-js ./assets/src"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"eslintConfig": {
		"extends": [
			"plugin:@wordpress/eslint-plugin/recommended",
			"plugin:jsdoc/recommended-typescript"
		],
		"rules": {
			"jsdoc/require-param-type": "off",
			"jsdoc/require-returns-type": "off",
			"jsdoc/require-returns": "off",
			"jsdoc/require-param-description": "off",
			"jsdoc/require-returns-description": "off",
			"jsdoc/newline-after-description": "off",
			"jsdoc/require-param": "off",
			"jsdoc/tag-lines": [
				"warn",
				"any",
				{
					"startLines": 1
				}
			],
			"prettier/prettier": "off"
		},
		"settings": {
			"import/resolver": {
				"typescript": {
					"alwaysTryTypes": true,
					"project": "./tsconfig.json"
				}
			}
		},
		"env": {
			"browser": true,
			"es6": true,
			"jquery": true
		},
		"parser": "@typescript-eslint/parser",
		"globals": {
			"jQuery": true,
			"$": true
		}
	},
	"stylelint": {
		"extends": [
			"@wordpress/stylelint-config",
			"@wordpress/stylelint-config/scss"
		]
	},
	"prettier": "@wordpress/prettier-config"
}
