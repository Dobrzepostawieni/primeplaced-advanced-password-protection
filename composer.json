{
	"name": "dobrzepostawieni/primeplaced-advanced-password-protection",
	"description": "PrimePlaced - Password Protect Site & Staging for WordPress",
	"homepage": "https://dobrzepostawieni.pl",
	"license": "GPL-3.0-or-later",
	"type": "wordpress-plugin",
	"authors": [
		{
			"name": "Kamil Jonik",
			"email": "kamil@dobrzepostawieni.pl",
			"homepage": "https://dobrzepostawieni.pl"
		}
	],
	"require": {
		"php": ">=7.4",
		"composer/installers": "^2.0",
		"freemius/wordpress-sdk": "^2.13",
		"inpsyde/assets": "^2.13",
		"inpsyde/wp-context": ">=1.5.1 <1.6.0"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/wp-cli-stubs": "^2.12",
		"phpstan/phpstan-deprecation-rules": "^1.2",
		"phpstan/phpstan-strict-rules": "^1.6",
		"slevomat/coding-standard": "^8.14",
		"squizlabs/php_codesniffer": "^3.13",
		"szepeviktor/phpstan-wordpress": "^1.3",
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0",
		"wp-coding-standards/wpcs": "dev-develop"
	},
	"scripts": {
		"analyse": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=1G",
		"lint": "phpcs --standard=phpcs.xml.dist",
		"test:unit": "phpunit -c phpunit-unit.xml.dist",
		"test:integration": "phpunit -c phpunit.xml.dist",
		"test:rest": "phpunit -c phpunit-rest.xml.dist",
		"test:multisite": "phpunit -c phpunit-multisite.xml.dist"
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"autoload": {
		"psr-4": {
			"PPADVP\\Engine\\": "Engine/",
			"PPADVP\\Backend\\": "Backend/",
			"PPADVP\\Services\\": "Services/",
			"PPADVP\\Rest\\": "Rest/",
			"PPADVP\\Rest\\Traits\\": "Rest/Traits/",
			"PPADVP\\Frontend\\": "Frontend/",
			"PPADVP\\Integrations\\": "Integrations/",
			"PPADVP\\Internals\\": "Internals/"
		}
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"ergebnis/composer-normalize": true,
			"phpro/grumphp": true
		},
		"platform": {
			"php": "7.4.33"
		},
		"sort-packages": true
	}
}
